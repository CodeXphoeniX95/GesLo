{
  "version": 2,
  "services": {
    "frontend": {
      "root": "frontend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/icon.png",
      "destination": "/frontend/dist/icon.png"
    },
    {
      "source": "/favicon.ico",
      "destination": "/frontend/dist/favicon.ico"
    },
    {
      "source": "/((?!api/|health).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
